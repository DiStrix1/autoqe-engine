# =============================================================================
# QE-RAG-System — Root Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# =============================================================================

# PostgreSQL password for the pgvector-db container
# Production: generate with: openssl rand -hex 32
POSTGRES_PASSWORD=dev_password

# Neo4j password for the neo4j-db container
# Production: generate with: openssl rand -hex 32
NEO4J_PASSWORD=dev_password

# Grafana admin password
# Production: generate with: openssl rand -hex 16
GRAFANA_ADMIN_PASSWORD=admin

# Security Authentication (Spring Boot & Python Parser)
# Set to 'true' in production to enforce API key validation on all endpoints
QE_SECURITY_ENABLED=false

# API key(s) — comma-separated list of valid keys.
# Required when QE_SECURITY_ENABLED=true.
# Production: generate with: openssl rand -hex 32
QE_SECURITY_API_KEYS=

# Frontend API key (Vite build or runtime)
# Set this to match one of the QE_SECURITY_API_KEYS when QE_SECURITY_ENABLED=true
VITE_API_KEY=

# Rate Limiting: Trust X-Forwarded-For header
# Set to 'true' ONLY when running behind a verified reverse proxy that strips client headers
QE_RATELIMIT_TRUST_FORWARDED_FOR=false

# CORS allowed origins for the Spring Boot backend (comma-separated).
# Production: set to your deployed frontend domain(s) only.
QE_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Async thread pool configuration for test generation jobs
QE_ASYNC_CORE_POOL_SIZE=2
QE_ASYNC_MAX_POOL_SIZE=4
QE_ASYNC_QUEUE_CAPACITY=10

# OpenTelemetry OTLP endpoint (traces)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

