# Parser Service — Environment Variables

# Copy this file to .env in the parser-service/ directory and fill in your values.
# The parser service reads ALL credentials from environment variables — never hardcoded.

# =============================================================================
# Neo4j Graph Database
# =============================================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=dev_password

# =============================================================================
# PostgreSQL + pgvector
# =============================================================================
PG_HOST=localhost
PG_PORT=5432
PG_DB=code_vectors
PG_USER=dev_user
PG_PASSWORD=dev_password

# =============================================================================
# FastAPI server (optional — defaults shown)
# =============================================================================
PORT=8000

# =============================================================================
# CORS (Improvement #B)
# Comma-separated list of allowed frontend origins.
# Default is localhost dev origins. Do NOT use * in production.
# =============================================================================
PARSER_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# =============================================================================
# Embedding Model (Improvement #N)
# Must match the Java backend's AllMiniLmL6V2QuantizedEmbeddingModel (384-dim).
# Both services MUST use the same model and dimension. Update both together.
# =============================================================================
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIM=384
