# =============================================================
# AutoQE / QE-RAG System — .gitignore
# Production-ready Git Ignore Configuration
# =============================================================

# ── Environment & Secrets ─────────────────────────────────────
# Never commit credentials, tokens, or environment files
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.*
!.env.example
!**/.env.example

# ── Python / Parser Service ───────────────────────────────────
__pycache__/
**/*__pycache__*
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
pip-log.txt
pip-delete-this-directory.txt
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.log
.pytest_cache/
htmlcov/
*.egg-info/
.installed.cfg
*.egg
.mypy_cache/
.ruff_cache/

# Model & Tokenizer Caching
models/
.transformers_cache/
huggingface/

# ── Node.js / Frontend ────────────────────────────────────────
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
dist/
dist-ssr/
build/
*.local
.output/
.nitro/
.tanstack/
.vite/
.cache/
.npm
*.tsbuildinfo

# ── Java / Maven ──────────────────────────────────────────────
target/
**/target/
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*
.mvn/timing.properties
.flattened-pom.xml

# Generated test files from AI test runs (ephemeral sandbox output)
test-sandbox/src/test/java/**/Generated*.java
test-sandbox/target/
backend/target/

# ── Docker & Volume Storage ───────────────────────────────────
docker-volumes/
monitoring/grafana/data/
monitoring/prometheus/data/

# ── IDEs & Developer Tools ────────────────────────────────────
# Visual Studio Code
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (IntelliJ IDEA, PyCharm, WebStorm, etc.)
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse
.classpath
.project
.settings/
bin/

# NetBeans
nbproject/private/
build/
nbdist/
.nb-attrs

# AI Assistants & Local Tooling
.claude/
.impeccable/
.gemini/

# ── Operating System Artifacts ─────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Temporary & Scratch Files ─────────────────────────────────
scratch/
tmp/
*.tmp
*.bak
*.swp
*~
